# Set these as Environment Variables in your Netlify site
# (Site configuration -> Environment variables) — NOT in this file.
# This file is just a reference for which variables the site needs.

# The password you'll type into /admin/ to log in.
ADMIN_PASSWORD=choose-a-real-password

# Any long random string — used to sign admin login sessions.
# Example: run `openssl rand -hex 32`, or just mash the keyboard for 40+ characters.
ADMIN_SECRET=change-this-to-a-long-random-string
